# SAGA configuration. Copy to .env.local (local dev) or /etc/saga/env (server) and fill in.
# Never commit the filled-in copy: .gitignore excludes every .env.* except this example.

# ---- Model ----
# Path to the fine-tuned SegFormer checkpoint folder (contains config.json + model.safetensors).
# Leave unset to fall back to the public Cityscapes baseline from Hugging Face.
AG_MODEL=models/b2_8k/best
# Flip-averaging at inference: 1 = slightly more accurate, 2x slower (use 0 on CPU servers).
AG_TTA=0
# Hugging Face cache for the baseline weights.
HF_HOME=.cache/hf

# ---- Login (generate these four with scripts/set_password.py; only hashes go here) ----
#   python scripts/set_password.py --questions "Q1?|Q2?|Q3?|Q4?" --answers yes,no,yes,yes --out .env.local
AG_GATE_QUESTIONS=Are you a person?|Are you here to audit sidewalks?|Is this your first visit?|Do you agree to the privacy notice?
AG_GATE_HASH=scrypt$...$...
AG_PASSWORD_HASH=scrypt$...$...
AG_SESSION_SECRET=replace-with-64-random-hex-characters
# 1 behind HTTPS (production), 0 for http://localhost.
AG_SECURE_COOKIE=0
# Set to "off" only for automated tests; disables the login gate entirely.
# AG_AUTH=off

# ---- Moderation ----
# Random token for DELETE /api/reports/<id> (header X-Admin-Token).  openssl rand -hex 24
AG_ADMIN_TOKEN=replace-with-a-random-token

# ---- Limits ----
# Photo uploads allowed per IP per 10 minutes.
AG_APP_LIMIT=30

# ---- Voice (ElevenLabs, optional; voice features stay hidden without a key) ----
AG_ELEVENLABS_KEY=
# Voice ID from your ElevenLabs voice library (default: "George").
AG_ELEVENLABS_VOICE=JBFqnCBsd6RMkjVDRZzb
# eleven_multilingual_v2 (best quality) or eleven_flash_v2_5 (faster, fewer credits).
AG_ELEVENLABS_MODEL=eleven_multilingual_v2

# ---- Deployment helpers (used by deploy/deploy.sh and remote/gpu.sh, not by the server) ----
# AG_HOST=root@your-server-ip
# AG_SSH_PORT=22
# AG_DOMAIN=your-domain.example
# AG_GPU_HOST=root@your-gpu-box
# AG_GPU_PORT=22
